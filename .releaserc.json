{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "publishCmd": "./gradlew publish -Pversion=${nextRelease.version} && ./scripts/promote-central.sh com.mailkube"
      }
    ],
    "@semantic-release/github"
  ]
}
